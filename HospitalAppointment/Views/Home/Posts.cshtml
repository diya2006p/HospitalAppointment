
@model IEnumerable<HospitalAppointment.Controllers.Post>

@{
    ViewData["Title"] = "Posts";
}

<div class="container mt-4">
    <h2 class="text-primary">Posts from JSONPlaceholder</h2>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Post ID</th>
                <th>Title</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var post in Model)
            {
                <tr>
                    <td>@post.Id</td>
                    <td>@post.Title</td>
                </tr>
            }
        </tbody>
    </table>

    <a asp-controller="Doctors"
       asp-action="Index"
       class="btn btn-secondary">
        Back to Doctors
    </a>
</div>

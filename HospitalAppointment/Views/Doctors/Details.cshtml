
@model HospitalAppointment.Models.Doctor

@{
    ViewData["Title"] = "Doctor Details";
}

<div class="container mt-4">
    <h2 class="text-primary">Doctor Details</h2>

    <div class="card p-4 shadow-sm">
        <p><strong>Doctor ID:</strong> @Model.DoctorId</p>
        <p><strong>Name:</strong> @Model.DoctorName</p>
        <p><strong>Specialization:</strong> @Model.Specialization</p>
        <p><strong>Experience:</strong> @Model.Experience years</p>
        <p><strong>Consultation Fee:</strong>
            ₹@Model.ConsultationFee</p>

        <hr />

        <p><strong>Service Charge:</strong> ₹100</p>

        <h4 class="text-success">
            Total Charge: ₹@ViewBag.TotalCharge
        </h4>

        <a asp-action="Appointment"
           asp-route-doctorId="@Model.DoctorId"
           class="btn btn-success">
            Book Appointment
        </a>

        <a asp-action="Index"
           class="btn btn-secondary mt-2">
            Back to Doctors
        </a>
    </div>
</div>
